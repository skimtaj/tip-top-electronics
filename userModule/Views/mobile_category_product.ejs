<!DOCTYPE html>
<html lang="en">
<%-include('header')%>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Search Results - ShopEasy</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        :root {
            --primary: #4361EE;
            --secondary: #7209B7;
            --accent: #F72585;
            --light-bg: #F8F9FA;
            --dark-text: #212529;
            --light-text: #6C757D;
            --white: #ffffff;
            --card-bg: #FFFFFF;
            --shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            --hover-shadow: 0 4px 12px rgba(0, 0, 0, 0.12);

            /* fluid tokens */
            --page-pad: clamp(10px, 3vw, 15px);
            --gap: clamp(10px, 2.5vw, 18px);
            --card-pad: clamp(10px, 2.5vw, 15px);
            --img-size: clamp(76px, 20vw, 120px);
        }

        html {
            -webkit-text-size-adjust: 100%;
        }

        body {
            background-color: var(--light-bg);
            color: var(--dark-text);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 var(--page-pad);
            /* clears the fixed header, scales down on small screens */
            margin-top: 20px
        }

        /* ============================================================
           SECTION SHARED
        ============================================================ */
        .vertical-products-section {
            background-color: var(--card-bg);
            border-radius: 10px;
            box-shadow: var(--shadow);
            padding: var(--card-pad);
            margin-bottom: var(--card-pad);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--card-pad);
            padding-bottom: 8px;
            border-bottom: 1px solid #eee;
            gap: 6px 10px;
            flex-wrap: wrap;
        }

        .section-title {
            font-size: clamp(15px, 4vw, 18px);
            font-weight: 700;
            color: var(--dark-text);
            position: relative;
            line-height: 1.3;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 40px;
            height: 2px;
            background: linear-gradient(to right, var(--accent), var(--secondary));
            border-radius: 2px;
        }

        .result-count {
            font-size: clamp(11px, 3vw, 14px);
            font-weight: 500;
            color: var(--light-text);
            margin-left: 4px;
        }

        .view-all {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
            display: inline-flex;
            align-items: center;
            font-size: clamp(11px, 3vw, 13px);
            white-space: nowrap;
            min-height: 34px;
            padding: 0 2px;
            touch-action: manipulation;
        }

        .view-all:hover {
            color: var(--secondary);
        }

        .view-all i {
            margin-left: 4px;
            font-size: 12px;
        }

        .search-clear-link {
            color: var(--accent);
        }

        .search-clear-link:hover {
            color: var(--secondary);
        }

        /* ============================================================
           VERTICAL PRODUCTS / SEARCH RESULTS
        ============================================================ */
        .vertical-products-list {
            display: flex;
            flex-direction: column;
            gap: clamp(8px, 2vw, 12px);
        }

        .vertical-product-row {
            display: flex;
            align-items: center;
            gap: var(--gap);
            padding: clamp(9px, 2.5vw, 14px);
            border: 1px solid #eee;
            border-radius: 8px;
            background: var(--card-bg);
            transition: box-shadow 0.3s, transform 0.3s;
            cursor: pointer;
            position: relative;
            min-width: 0;
        }

        .vertical-product-image {
            flex: 0 0 auto;
            width: var(--img-size);
            height: var(--img-size);
            border-radius: 8px;
            overflow: hidden;
            background: #f5f5f5;
        }

        .image-link {
            display: block;
            width: 100%;
            height: 100%;
        }

        .vertical-product-image img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .vertical-product-info {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            gap: clamp(4px, 1.5vw, 8px);
            min-width: 0;
        }

        .vertical-product-info .product-title {
            font-size: clamp(13px, 3.4vw, 16px);
            font-weight: 600;
            color: var(--dark-text);
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            overflow-wrap: anywhere;
            line-height: 1.4;
            margin: 0;
        }

        .vertical-product-info .product-title:hover {
            color: var(--primary);
        }

        .vertical-product-info .product-price {
            font-size: clamp(13px, 3.6vw, 16px);
            font-weight: 700;
            color: var(--dark-text);
            margin: 0;
        }

        .vertical-product-info .add-to-cart {
            align-self: flex-start;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 34px;
            padding: 0 16px;
            font-size: clamp(11px, 3vw, 13px);
            width: auto;
            margin-top: 2px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            font-family: inherit;
            white-space: nowrap;
            touch-action: manipulation;
        }

        .vertical-product-info .add-to-cart:active {
            transform: scale(0.97);
        }

        @media (hover: hover) and (pointer: fine) {
            .vertical-product-row:hover {
                box-shadow: var(--hover-shadow);
                transform: translateY(-2px);
            }

            .vertical-product-row:hover .vertical-product-image img {
                transform: scale(1.05);
            }

            .vertical-product-info .add-to-cart:hover {
                transform: translateY(-1px);
            }
        }

        /* ============================================================
           EMPTY STATE
        ============================================================ */
        .new-arrivals-empty {
            text-align: center;
            padding: clamp(24px, 6vw, 30px) var(--page-pad);
            color: var(--light-text);
            font-size: clamp(12px, 3.2vw, 14px);
            background: #f9fafb;
            border-radius: 8px;
            border: 1px dashed #e0e3e7;
        }

        .new-arrivals-empty i {
            font-size: clamp(26px, 7vw, 32px);
            color: #cfd4da;
            margin-bottom: 8px;
            display: block;
        }

        .new-arrivals-empty p {
            margin: 4px 0;
        }

        .new-arrivals-empty p strong {
            color: var(--dark-text);
        }

        /* ============================================================
           STICKY CONTACT
        ============================================================ */
        .sticky-contact {
            position: fixed;
            bottom: max(12px, env(safe-area-inset-bottom));
            right: max(12px, env(safe-area-inset-right));
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 99;
        }

        .whatsapp-btn,
        .call-btn {
            width: clamp(40px, 10vw, 42px);
            height: clamp(40px, 10vw, 42px);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: clamp(16px, 4.2vw, 18px);
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            touch-action: manipulation;
        }

        .whatsapp-btn {
            background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
        }

        .call-btn {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        }

        .whatsapp-btn:active,
        .call-btn:active {
            transform: scale(0.94);
        }

        @media (hover: hover) and (pointer: fine) {
            .whatsapp-btn:hover,
            .call-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            }
        }

        /* ============================================================
           RESPONSIVE BREAKPOINTS
        ============================================================ */
        @media (max-width: 768px) {
            .section-title::after {
                bottom: -8px;
            }

            .container {
                    margin-top:30px
                }

            .section-header {
                padding-bottom: 6px;
            }
        }

        @media (max-width: 480px) {
            :root {
                --img-size: clamp(70px, 22vw, 90px);
                --gap: 11px;
            }

            .vertical-product-row {
                border-radius: 7px;
            }

            .vertical-product-info .add-to-cart {
                padding: 0 13px;
                min-height: 32px;
            }
        }

        @media (max-width: 360px) {
            :root {
                --img-size: 64px;
                --gap: 9px;
                --card-pad: 9px;
            }

            .vertical-product-info .product-title {
                -webkit-line-clamp: 2;
            }
        }

        @media (max-height: 480px) and (orientation: landscape) {
            .container {
                margin-top: 70px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.001ms !important;
                transition-duration: 0.001ms !important;
            }
        }
    </style>
</head>

<body>
    <main class="container">

        <!-- ============================================================
             SEARCH RESULTS (MOBILE CATEGORY)
        ============================================================ -->
        <section class="vertical-products-section">
            <div class="section-header">
                <h2 class="section-title">
                    Search Results
                    <span class="result-count"></span>
                </h2>
                <a href="/" class="view-all search-clear-link">
                    Clear Search <i class="fas fa-times"></i>
                </a>
            </div>

            <div class="vertical-products-list">

                <% mobileCategory.forEach((mc)=>{ %>

                    <div class="vertical-product-row">
                        <div class="vertical-product-image">
                            <a href="/products/view-details/<%=mc._id%>" class="image-link">
                                <img src="/uploads/<%=mc.product_image%>" alt="<%=mc.product_name%>" loading="lazy"
                                    decoding="async">
                            </a>
                        </div>
                        <div class="vertical-product-info">
                            <a href="/products/view-details/<%=mc._id%>" class="product-title">
                                <%=mc.product_name%>
                            </a>
                            <div class="product-price">₹<%=mc.sale_price%>
                            </div>
                            <button onclick="window.location.href='/add-to-cart/<%=mc._id%>'" class="add-to-cart">
                                Add to Cart
                            </button>
                        </div>
                    </div>

                    <% })%>

            </div>

            <!-- Empty state (kept hidden; unhide by setting display:block and hiding the list) -->
            <div class="new-arrivals-empty" style="display:none;">
                <i class="fas fa-search-minus"></i>
                <p><strong>No results for your search query.</strong></p>
                <p>Try checking your spelling or use more general terms</p>
            </div>
        </section>

    </main>

    <!-- Sticky Contact Buttons -->
    <div class="sticky-contact">
        <a href="https://wa.me/1234567890" class="whatsapp-btn" target="_blank" rel="noopener"
            aria-label="Contact on WhatsApp">
            <i class="fab fa-whatsapp"></i>
        </a>
        <a href="tel:+1234567890" class="call-btn" aria-label="Call us">
            <i class="fas fa-phone"></i>
        </a>
    </div>

</body>

</html>