    <!-- Sticky Contact Buttons -->
    <div class="sticky-contact">
        <a href="https://wa.me/1234567890" class="whatsapp-btn" target="_blank" aria-label="Contact on WhatsApp">
            <i class="fab fa-whatsapp"></i>
        </a>
        <a href="tel:+1234567890" class="call-btn" aria-label="Call us">
            <i class="fas fa-phone"></i>
        </a>
    </div>

    <script>
        // ============================================
        // Truncate product names to first 4 words
        // ============================================
        function truncateToWords(el, wordLimit = 4) {
            const fullText = el.textContent.trim().replace(/\s+/g, ' ');
            el.dataset.fullTitle = fullText;
            el.setAttribute('title', fullText);

            const words = fullText.split(' ');
            if (words.length > wordLimit) {
                el.textContent = words.slice(0, wordLimit).join(' ') + '…';
            }
        }

        document
            .querySelectorAll('.product-title, .new-arrival-title')
            .forEach(el => truncateToWords(el, 4));

        // ============================================
        // Slider functionality (only if slider exists)
        // ============================================
        (function () {
            const slidesEl = document.querySelector('.slides');
            if (!slidesEl) return;

            const slideCount = document.querySelectorAll('.slide').length;
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const dots = document.querySelectorAll('.slider-dot');
            if (!slideCount || !prevBtn || !nextBtn) return;

            let currentSlide = 0;

            function goToSlide(index) {
                if (index < 0) {
                    currentSlide = slideCount - 1;
                } else if (index >= slideCount) {
                    currentSlide = 0;
                } else {
                    currentSlide = index;
                }

                slidesEl.style.transform = `translateX(-${currentSlide * 25}%)`;

                dots.forEach(dot => dot.classList.remove('active'));
                if (dots[currentSlide]) dots[currentSlide].classList.add('active');
            }

            function nextSlide() { goToSlide(currentSlide + 1); }
            function prevSlide() { goToSlide(currentSlide - 1); }

            let slideInterval = setInterval(nextSlide, 5000);

            function resetInterval() {
                clearInterval(slideInterval);
                slideInterval = setInterval(nextSlide, 5000);
            }

            nextBtn.addEventListener('click', () => { nextSlide(); resetInterval(); });
            prevBtn.addEventListener('click', () => { prevSlide(); resetInterval(); });

            dots.forEach(dot => {
                dot.addEventListener('click', () => {
                    const index = parseInt(dot.getAttribute('data-index'));
                    goToSlide(index);
                    resetInterval();
                });
            });
        })();

        // ============================================
        // Add to cart functionality
        // ============================================
        const addToCartButtons = document.querySelectorAll('.add-to-cart');
        let cartItems = [];

        addToCartButtons.forEach(button => {
            button.addEventListener('click', () => {

                // --- Server-side add to cart (New Arrivals) ---
                if (button.dataset.cartUrl) {
                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
                    window.location.href = button.dataset.cartUrl;
                    return;
                }

                // --- Client-side demo (static Best Selling cards) ---
                const productCard = button.closest('.product-card, .new-arrival-card');
                const titleEl = productCard.querySelector('.product-title, .new-arrival-title');
                const productTitle = titleEl.dataset.fullTitle || titleEl.textContent.trim();
                const productPrice = productCard.querySelector('.product-price, .new-arrival-price').textContent.trim();

                cartItems.push({
                    title: productTitle,
                    price: productPrice
                });

                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: `${productTitle} added to cart!`,
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: true
                });

                console.log('Cart items:', cartItems);
            });
        });
    </script>
</body>

