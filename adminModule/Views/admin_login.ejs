<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tip Top Electronics — Admin Login</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --text: #0f172a;
            --muted: #64748b;
            --line: #e2e8f0;
            --primary: #4f46e5;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            color: var(--text);
            background: #f6f7fb;
            position: relative;
            overflow-x: hidden;
        }

        /* ================= Animated background ================= */
        .bg-decor {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
            background: linear-gradient(180deg, #f9faff 0%, #f3f4fb 100%);
        }

        .bg-decor::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(99, 102, 241, .22) 1px, transparent 1px);
            background-size: 26px 26px;
            opacity: .75;
            -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 42%, #000 25%, transparent 72%);
            mask-image: radial-gradient(ellipse 75% 60% at 50% 42%, #000 25%, transparent 72%);
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(70px);
            will-change: transform;
        }

        .blob-1 {
            width: 540px;
            height: 540px;
            top: -170px;
            left: -150px;
            background: #818cf8;
            opacity: .5;
            animation: float-a 18s ease-in-out infinite;
        }

        .blob-2 {
            width: 470px;
            height: 470px;
            bottom: -190px;
            right: -130px;
            background: #c084fc;
            opacity: .45;
            animation: float-b 22s ease-in-out infinite;
        }

        .blob-3 {
            width: 380px;
            height: 380px;
            top: 38%;
            left: 58%;
            background: #22d3ee;
            opacity: .28;
            animation: float-c 26s ease-in-out infinite;
        }

        @keyframes float-a {

            0%,
            100% {
                transform: translate3d(0, 0, 0) scale(1);
            }

            50% {
                transform: translate3d(60px, 50px, 0) scale(1.12);
            }
        }

        @keyframes float-b {

            0%,
            100% {
                transform: translate3d(0, 0, 0) scale(1);
            }

            50% {
                transform: translate3d(-70px, -45px, 0) scale(1.08);
            }
        }

        @keyframes float-c {

            0%,
            100% {
                transform: translate3d(0, 0, 0) scale(1);
            }

            50% {
                transform: translate3d(-50px, 60px, 0) scale(1.15);
            }
        }

        /* ================= Card ================= */
        .card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 440px;
            background: rgba(255, 255, 255, .86);
            backdrop-filter: blur(14px) saturate(140%);
            -webkit-backdrop-filter: blur(14px) saturate(140%);
            border: 1px solid rgba(238, 240, 246, .9);
            border-radius: 20px;
            padding: 34px 32px 26px;
            box-shadow: 0 1px 2px rgba(15, 23, 42, .04), 0 22px 45px -14px rgba(15, 23, 42, .16);
            animation: rise .45s ease both;
        }

        @keyframes rise {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* brand row */
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .logo {
            width: 46px;
            height: 46px;
            flex: 0 0 auto;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: #fff;
            font-weight: 700;
            font-size: 17px;
            letter-spacing: .3px;
            box-shadow: 0 10px 20px -8px rgba(99, 102, 241, .85);
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .brand-name {
            display: inline-block;
            font-size: 15.5px;
            font-weight: 800;
            letter-spacing: -.2px;
            padding: 3px 9px;
            border-radius: 8px;
            color: #312e81;
            background: linear-gradient(120deg, #c7d2fe 0%, #ddd6fe 50%, #a5f3fc 100%);
            box-shadow: 0 2px 0 rgba(99, 102, 241, .25), inset 0 0 0 1px rgba(99, 102, 241, .18);
            transform: rotate(-1deg);
        }

        .brand-tag {
            font-size: 12px;
            color: var(--muted);
            margin-top: 4px;
            margin-left: 2px;
        }

        h1 {
            font-size: 22px;
            margin: 0 0 6px;
            letter-spacing: -.3px;
            display: inline-block;
            background: linear-gradient(90deg, #4338ca, #7c3aed 55%, #0891b2);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .sub {
            margin: 0 0 22px;
            font-size: 14px;
            color: var(--muted);
        }

        .field {
            margin-bottom: 15px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 7px;
        }

        .control {
            position: relative;
        }

        .control .icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: #94a3b8;
            pointer-events: none;
            transition: color .18s;
        }

        .control input {
            width: 100%;
            height: 48px;
            padding: 0 14px 0 42px;
            border: 1.5px solid var(--line);
            border-radius: 11px;
            background: #fbfcfe;
            font-family: inherit;
            font-size: 14.5px;
            color: var(--text);
            outline: none;
            transition: border-color .18s, box-shadow .18s, background .18s;
        }

        .control input::placeholder {
            color: #a8b1c2;
        }

        .control input:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, .12);
        }

        .control input:focus~.icon {
            color: var(--primary);
        }

        .has-toggle input {
            padding-right: 48px;
        }

        .toggle {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border: 0;
            border-radius: 9px;
            background: transparent;
            color: #94a3b8;
            cursor: pointer;
            transition: background .15s, color .15s;
        }

        .toggle:hover {
            background: #f1f5f9;
            color: #475569;
        }

        .toggle svg {
            width: 18px;
            height: 18px;
        }

        .toggle .eye-off {
            display: none;
        }

        .toggle.is-visible .eye-on {
            display: none;
        }

        .toggle.is-visible .eye-off {
            display: block;
        }

        /* remember me + forgot password */
        .options-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 2px 0 16px;
            font-size: 13px;
        }

        .remember {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            font-size: 13px;
            font-weight: 500;
            color: #475569;
            cursor: pointer;
        }

        .remember input[type="checkbox"] {
            width: 16px;
            height: 16px;
            margin: 0;
            padding: 0;
            flex: 0 0 auto;
            accent-color: var(--primary);
            cursor: pointer;
        }

        .link-btn {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            background: none;
            border: 0;
            padding: 0;
            font: inherit;
            cursor: pointer;
        }

        .link-btn:hover {
            text-decoration: underline;
        }

        .btn {
            width: 100%;
            height: 50px;
            margin-top: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border: 0;
            border-radius: 11px;
            background: linear-gradient(135deg, #6366f1, #7c3aed);
            color: #fff;
            font-family: inherit;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 12px 22px -10px rgba(99, 102, 241, .9);
            transition: transform .18s, box-shadow .18s, opacity .18s;
        }

        .btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 16px 26px -10px rgba(99, 102, 241, .95);
        }

        .btn:active:not(:disabled) {
            transform: translateY(0);
        }

        .footer {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid #eef0f6;
            text-align: center;
            font-size: 13.5px;
            line-height: 1.5;
            color: var(--muted);
        }

        .footer a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        @media (max-width:420px) {
            .card {
                padding: 28px 22px 22px;
            }

            h1 {
                font-size: 20px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .blob {
                animation: none;
            }

            .card {
                animation: none;
            }
        }

        /* ===== Forgot-password modal tweaks ===== */
        #forgotPasswordModal .modal-content {
            border: 0;
            border-radius: 16px;
            box-shadow: 0 24px 60px -20px rgba(15, 23, 42, .35);
        }

        #forgotPasswordModal .modal-header {
            border-bottom: 1px solid #eef0f6;
            padding: 18px 22px;
        }

        #forgotPasswordModal .modal-title {
            font-size: 17px;
            font-weight: 700;
            color: #0f172a;
        }

        #forgotPasswordModal .modal-body {
            padding: 20px 22px 8px;
        }

        #forgotPasswordModal .modal-footer {
            border-top: 1px solid #eef0f6;
            padding: 14px 22px 18px;
        }

        #forgotPasswordModal .field {
            margin-bottom: 10px;
        }

        #forgotPasswordModal .control input {
            height: 44px;
            font-size: 14px;
        }

        #forgotPasswordModal .control .icon {
            width: 16px;
            height: 16px;
        }
    </style>
</head>

<body>

    <% if (messages.success) { %>
        <script>
            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "success",
                title: "<%= messages.success %>",
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        </script>
        <% } %>

            <% if (messages.error) { %>
                <script>
                    Swal.fire({
                        toast: true,
                        position: "top-end",
                        icon: "error",
                        title: "<%= messages.error %>",
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });
                </script>
                <% } %>

                    <!-- background decoration (purely visual) -->
                    <div class="bg-decor" aria-hidden="true">
                        <span class="blob blob-1"></span>
                        <span class="blob blob-2"></span>
                        <span class="blob blob-3"></span>
                    </div>

                    <main class="card">
                        <!-- brand -->
                        <div class="brand">
                            <div class="logo" aria-hidden="true">TT</div>
                            <div class="brand-text">
                                <span class="brand-name">Tip Top Electronics</span>
                                <span class="brand-tag">Admin Panel</span>
                            </div>
                        </div>

                        <h1>Admin Login</h1>
                        <p class="sub">Sign in with your administrator credentials to continue.</p>

                        <form id="loginForm" method="post" action="/admin/auth/login">

                            <!-- Email -->
                            <div class="field">
                                <label for="email">Email Address</label>
                                <div class="control">
                                    <input id="email" name="email" type="email"
                                        placeholder="admin@tiptopelectronics.com" autocomplete="username" />
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="4" width="20" height="16" rx="2" />
                                        <path d="m22 7-10 6L2 7" />
                                    </svg>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="field">
                                <label for="password">Password</label>
                                <div class="control has-toggle">
                                    <input id="password" name="password" type="password"
                                        placeholder="Enter your password" autocomplete="current-password" />
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                    <button type="button" class="toggle" data-target="password"
                                        aria-label="Show password">
                                        <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                        <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m3 3 18 18" />
                                            <path d="M10.6 10.6a3 3 0 0 0 4.2 4.2" />
                                            <path d="M9.9 5.2A11 11 0 0 1 12 5c6.5 0 10 7 10 7a18 18 0 0 1-3 4" />
                                            <path d="M6.6 6.6C3.8 8.4 2 12 2 12s3.5 7 10 7a10.8 10.8 0 0 0 5.4-1.4" />
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Remember me / forgot password -->
                            <div class="options-row">
                                <label class="remember" for="remember">
                                    <input id="remember" name="remember" type="checkbox" value="1" />
                                    <span>Remember me</span>
                                </label>
                                <button type="button" class="link-btn" data-bs-toggle="modal"
                                    data-bs-target="#forgotPasswordModal">
                                    Forgot password?
                                </button>
                            </div>

                            <button type="submit" class="btn">Sign In</button>
                        </form>

                        <p class="footer">
                            Don't have an admin account?<br />
                            Contact your <a href="mailto:support@tiptopelectronics.com">system administrator</a>.
                        </p>
                    </main>

                    <!-- ============================================================
               FORGOT PASSWORD MODAL
               ============================================================ -->
                    <div class="modal fade" id="forgotPasswordModal" tabindex="-1"
                        aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h2 class="modal-title" id="forgotPasswordModalLabel">Reset your password</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                </div>
                                <form method="post" action="/admin/auth/forgot-password">
                                    <div class="modal-body">
                                        <p style="font-size:13px;color:#475569;margin:0 0 14px;">
                                            Enter the email address linked to your admin account. We'll send you a link
                                            to reset your
                                            password.
                                        </p>

                                        <div class="field">
                                            <label for="forgot-email">Email Address</label>
                                            <div class="control">
                                                <input id="forgot-email" name="email" type="email"
                                                    placeholder="admin@tiptopelectronics.com" autocomplete="email" />
                                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="2" y="4" width="20" height="16" rx="2" />
                                                    <path d="m22 7-10 6L2 7" />
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-light"
                                            data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary"
                                            style="background:linear-gradient(135deg,#6366f1,#7c3aed);border:0;">Send
                                            Reset Link</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- password show / hide (only JS in the page besides protection) -->
                    <script>
                        document.querySelectorAll(".toggle").forEach(function (btn) {
                            btn.addEventListener("click", function () {
                                const input = document.getElementById(btn.dataset.target);
                                const show = input.type === "password";
                                input.type = show ? "text" : "password";
                                btn.classList.toggle("is-visible", show);
                                btn.setAttribute("aria-label", show ? "Hide password" : "Show password");
                                input.focus();
                            });
                        });
                    </script>

                    <!-- ============================================================
       ANTI-INSPECT PROTECTION
       ============================================================ -->
                    <script>
                        (function () {
                            'use strict';

                            var CONFIG = {
                                blockRightClick: true,
                                blockShortcuts: true,
                                blockSelection: true,
                                blockCopyCut: true,
                                blockDrag: true,
                                detectDevTools: true,
                                guardMessage: 'Developer tools detected. Please close them to continue.'
                            };

                            function isFormField(el) {
                                if (!el) return false;
                                var tag = (el.tagName || '').toUpperCase();
                                return tag === 'INPUT' || tag === 'TEXTAREA' || el.isContentEditable === true;
                            }

                            /* 1. Right-click */
                            if (CONFIG.blockRightClick) {
                                document.addEventListener('contextmenu', function (e) {
                                    e.preventDefault();
                                    return false;
                                }, false);
                            }

                            /* 2. Shortcuts */
                            if (CONFIG.blockShortcuts) {
                                document.addEventListener('keydown', function (e) {
                                    var key = (e.key || '').toLowerCase();
                                    var mod = e.ctrlKey || e.metaKey;

                                    if (e.key === 'F12' || e.keyCode === 123) {
                                        e.preventDefault(); e.stopPropagation(); return false;
                                    }
                                    if (mod && e.shiftKey && ['i', 'j', 'c', 'k'].indexOf(key) !== -1) {
                                        e.preventDefault(); e.stopPropagation(); return false;
                                    }
                                    if (mod && !e.shiftKey && ['u', 's'].indexOf(key) !== -1) {
                                        e.preventDefault(); e.stopPropagation(); return false;
                                    }
                                    if (mod && key === 'a' && CONFIG.blockSelection && !isFormField(e.target)) {
                                        e.preventDefault(); return false;
                                    }
                                }, true);
                            }

                            /* 3. Selection */
                            if (CONFIG.blockSelection) {
                                document.addEventListener('selectstart', function (e) {
                                    if (!isFormField(e.target)) e.preventDefault();
                                }, false);

                                var s = document.createElement('style');
                                s.textContent =
                                    'body{-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;}' +
                                    'input,textarea,[contenteditable="true"]{-webkit-user-select:text;-moz-user-select:text;-ms-user-select:text;user-select:text;}';
                                document.head.appendChild(s);
                            }

                            /* 4. Copy / cut */
                            if (CONFIG.blockCopyCut) {
                                ['copy', 'cut'].forEach(function (evt) {
                                    document.addEventListener(evt, function (e) {
                                        if (!isFormField(e.target)) e.preventDefault();
                                    }, false);
                                });
                            }

                            /* 5. Drag */
                            if (CONFIG.blockDrag) {
                                document.addEventListener('dragstart', function (e) { e.preventDefault(); }, false);
                            }

                            /* 6. DevTools overlay */
                            if (CONFIG.detectDevTools) {
                                var isTouch = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
                                if (!isTouch) {
                                    var guard = document.createElement('div');
                                    guard.setAttribute('aria-hidden', 'true');
                                    guard.style.cssText = [
                                        'position:fixed', 'inset:0', 'z-index:2147483647', 'display:none',
                                        'align-items:center', 'justify-content:center', 'text-align:center',
                                        'padding:32px', 'background:#f6f7fb',
                                        'font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif'
                                    ].join(';');
                                    guard.innerHTML =
                                        '<div><h2 style="margin:0 0 8px;font-size:19px;color:#0f172a;">' +
                                        CONFIG.guardMessage.replace(/</g, '&lt;') + '</h2>' +
                                        '<p style="margin:0;font-size:14px;color:#64748b;">' +
                                        'This page unlocks automatically once they are closed.</p></div>';

                                    var attach = function () {
                                        if (!document.body.contains(guard)) document.body.appendChild(guard);
                                    };
                                    if (document.body) attach();
                                    else document.addEventListener('DOMContentLoaded', attach);

                                    var THRESHOLD = 160, wasOpen = false;
                                    var check = function () {
                                        var open = (window.outerWidth - window.innerWidth) > THRESHOLD ||
                                            (window.outerHeight - window.innerHeight) > THRESHOLD;
                                        if (open !== wasOpen) {
                                            wasOpen = open;
                                            guard.style.display = open ? 'flex' : 'none';
                                        }
                                    };
                                    setInterval(check, 800);
                                    window.addEventListener('resize', check);
                                }
                            }
                        })();
                    </script>

</body>

</html>