<!DOCTYPE html>
<html lang="en">
<%-include('admin_sidebar')%>

    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ABM - Dashboard</title>

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            :root {
                --primary: #5B21B6;
                --primary-light: #8B5CF6;
                --primary-dark: #2E1065;
                --accent: #F59E0B;
                --white: #ffffff;
                --border: #DDD6FE;
                --shadow: 0 2px 8px rgba(91, 33, 182, 0.08);
                --sidebar: 260px;
            }

            body {
                background: #F5F3FF;
                min-height: 100vh;
                color: #1E1B4B;
            }

            .container {
                width: 100%;
                padding: 12px 16px;
                margin: 0 auto;
            }

            .main {
                display: grid;
                gap: 20px;
                margin-top: 50px;
            }

            /* ---- PAGE HEADER ---- */
            .page-head h1 {
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--primary-dark);
                margin-bottom: 4px;
            }

            .page-head p {
                font-size: 0.8rem;
                color: #6B6399;
            }

            /* ---- TABS ---- */
            .filter-bar {
                background: var(--white);
                padding: 10px 14px;
                border-radius: 14px;
                box-shadow: var(--shadow);
                border: 1px solid var(--border);
            }

            .filter-tabs {
                display: flex;
                gap: 6px;
                background: #F5F3FF;
                padding: 4px;
                border-radius: 10px;
                overflow-x: auto;
                scrollbar-width: none;
            }

            .filter-tabs::-webkit-scrollbar {
                display: none;
            }

            .filter-btn {
                border: 0;
                background: transparent;
                padding: 8px 16px;
                border-radius: 8px;
                font-size: 0.78rem;
                font-weight: 700;
                color: #5B21B6;
                cursor: pointer;
                white-space: nowrap;
                transition: all 0.2s ease;
            }

            .filter-btn:hover {
                background: #EDE9FE;
            }

            .filter-btn.active {
                background: linear-gradient(135deg, var(--primary), var(--primary-light));
                color: #fff;
                box-shadow: 0 4px 12px rgba(91, 33, 182, 0.30);
            }

            /* ---- PERIOD SECTION ---- */
            .period-section {
                display: none;
                flex-direction: column;
                gap: 12px;
            }

            .period-section.visible {
                display: flex;
            }

            .period-header {
                display: flex;
                align-items: baseline;
                gap: 10px;
                flex-wrap: wrap;
            }

            .period-title {
                font-size: 1.1rem;
                font-weight: 800;
                color: var(--primary-dark);
            }

            .period-sub {
                font-size: 0.72rem;
                color: #6B6399;
            }

            /* ---- SUMMARY CARDS ---- */
            .summary-row {
                display: grid;
                gap: 16px;
                grid-template-columns: repeat(4, 1fr);
            }

            .summary-card {
                display: flex;
                align-items: center;
                gap: 14px;
                background: var(--white);
                padding: 1.4rem 1.6rem;
                border-radius: 14px;
                box-shadow: var(--shadow);
                border-left: 4px solid var(--primary);
                transition: all 0.2s ease;
            }

            .summary-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(91, 33, 182, 0.15);
            }

            .summary-card.revenue {
                border-left-color: #10b981;
            }

            .summary-card.orders {
                border-left-color: #3b82f6;
            }

            .summary-card.profit {
                border-left-color: var(--accent);
            }

            .summary-card.sold {
                border-left-color: #ec4899;
            }

            .summary-icon {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.2rem;
                flex: none;
            }

            .revenue .summary-icon {
                background: #D1FAE5;
                color: #059669;
            }

            .orders .summary-icon {
                background: #DBEAFE;
                color: #2563eb;
            }

            .profit .summary-icon {
                background: #FEF3C7;
                color: #d97706;
            }

            .sold .summary-icon {
                background: #FCE7F3;
                color: #db2777;
            }

            .summary-details {
                flex: 1;
                min-width: 0;
            }

            .summary-value {
                font-size: 1.5rem;
                font-weight: 800;
                color: var(--primary-dark);
                margin-bottom: 2px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .summary-label {
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.7px;
                color: #4C3E7A;
                opacity: 0.85;
                display: block;
            }

            /* ---- SECTION HEADER ---- */
            .section-head {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 12px;
                flex-wrap: wrap;
                padding-top: 14px;
                margin-top: 4px;
                border-top: 1px solid var(--border);
            }

            .section-title {
                font-size: 1rem;
                font-weight: 800;
                color: var(--primary-dark);
                margin-bottom: 2px;
            }

            .section-sub {
                font-size: 0.74rem;
                color: #6B6399;
            }

            .section-badge {
                font-size: 0.66rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: var(--primary);
                background: #EDE9FE;
                padding: 4px 10px;
                border-radius: 999px;
            }

            /* ---- REPORT CARDS ---- */
            .report-row {
                display: grid;
                gap: 16px;
                grid-template-columns: repeat(3, 1fr);
            }

            .report-card {
                display: flex;
                align-items: center;
                gap: 14px;
                width: 100%;
                text-align: left;
                font-family: inherit;
                background: var(--white);
                padding: 1.2rem 1.4rem;
                border-radius: 14px;
                box-shadow: var(--shadow);
                border: 1px solid var(--border);
                border-left: 4px solid var(--primary);
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .report-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(91, 33, 182, 0.15);
            }

            .report-card.active {
                border-left-color: var(--accent);
                background: linear-gradient(135deg, #FFFFFF, #FAF8FF);
                box-shadow: 0 8px 25px rgba(91, 33, 182, 0.18);
            }

            .report-icon {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
                flex: none;
            }

            .report-card[data-report="sales"] .report-icon {
                background: #EDE9FE;
                color: var(--primary);
            }

            .report-card[data-report="customers"] .report-icon {
                background: #DBEAFE;
                color: #2563eb;
            }

            .report-card[data-report="stock"] .report-icon {
                background: #D1FAE5;
                color: #059669;
            }

            .report-details {
                flex: 1;
                min-width: 0;
            }

            .report-title {
                font-size: 0.92rem;
                font-weight: 800;
                color: var(--primary-dark);
                margin-bottom: 2px;
            }

            .report-desc {
                font-size: 0.72rem;
                color: #6B6399;
            }

            /* ---- DATE RANGE PANEL ---- */
            .date-range-panel {
                display: none;
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: 14px;
                box-shadow: var(--shadow);
                padding: 1.2rem 1.4rem;
            }

            .date-range-panel.visible {
                display: block;
                animation: fadeSlide 0.22s ease;
            }

            @keyframes fadeSlide {
                from {
                    opacity: 0;
                    transform: translateY(-6px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .date-range-form {
                display: flex;
                align-items: flex-end;
                gap: 14px;
                flex-wrap: wrap;
            }

            .date-field {
                display: flex;
                flex-direction: column;
                gap: 6px;
                flex: 1 1 170px;
                min-width: 0;
            }

            .date-field label {
                font-size: 0.68rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.7px;
                color: #4C3E7A;
            }

            .date-field input[type="date"] {
                width: 100%;
                padding: 10px 12px;
                font-size: 0.82rem;
                font-family: inherit;
                color: var(--primary-dark);
                background: #F5F3FF;
                border: 1px solid var(--border);
                border-radius: 10px;
                outline: none;
                transition: all 0.2s ease;
            }

            .date-field input[type="date"]:focus {
                background: #fff;
                border-color: var(--primary-light);
                box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
            }

            .btn-generate {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                border: 0;
                padding: 11px 20px;
                border-radius: 10px;
                font-size: 0.8rem;
                font-weight: 700;
                font-family: inherit;
                color: #fff;
                background: linear-gradient(135deg, var(--primary), var(--primary-light));
                box-shadow: 0 4px 12px rgba(91, 33, 182, 0.30);
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .btn-generate:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(91, 33, 182, 0.35);
            }

            /* ---- RESPONSIVE ---- */
            @media (min-width: 992px) {
                .container {
                    margin-left: var(--sidebar);
                    padding: 24px 32px;
                    max-width: calc(100% - var(--sidebar));
                }

                .main {
                    margin-top: 58px;
                    gap: 22px;
                }

                .page-head h1 {
                    font-size: 1.5rem;
                }
            }

            @media (max-width: 991.98px) {
                .summary-row {
                    grid-template-columns: repeat(2, 1fr);
                }

                .report-row {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (max-width: 767.98px) {
                .main {
                    margin-top: 42px;
                    gap: 14px;
                }

                .filter-tabs {
                    width: 100%;
                }

                .filter-btn {
                    flex: 1;
                    padding: 9px 10px;
                    font-size: 0.74rem;
                }

                .summary-row {
                    grid-template-columns: 1fr;
                    gap: 12px;
                }

                .summary-card {
                    padding: 1.1rem 1.2rem;
                    gap: 12px;
                }

                .summary-icon {
                    width: 42px;
                    height: 42px;
                    font-size: 1.05rem;
                }

                .summary-value {
                    font-size: 1.3rem;
                }

                .report-row {
                    grid-template-columns: 1fr;
                    gap: 12px;
                }

                .report-card {
                    padding: 1rem 1.1rem;
                }

                .date-range-form {
                    gap: 12px;
                }

                .date-field {
                    flex: 1 1 100%;
                }

                .btn-generate {
                    width: 100%;
                    justify-content: center;
                }
            }

            @media (max-width: 575.98px) {
                .summary-card {
                    padding: 0.95rem 1rem;
                    gap: 10px;
                }

                .summary-icon {
                    width: 38px;
                    height: 38px;
                    font-size: 0.95rem;
                }

                .summary-value {
                    font-size: 1.2rem;
                }
            }
        </style>
    </head>

    <body>
        <div class="container" id="top">
            <main class="content">
                <div class="main">

                    <!-- PAGE HEADER -->
                    <div class="page-head">
                        <h1>Dashboard Overview</h1>
                        <p>Key metrics at a glance</p>
                    </div>

                    <!-- TABS -->
                    <div class="filter-bar">
                        <div class="filter-tabs">
                            <button type="button" class="filter-btn active" data-filter="today">Today</button>
                            <button type="button" class="filter-btn" data-filter="week">Last Week</button>
                            <button type="button" class="filter-btn" data-filter="month">Last Month</button>
                        </div>
                    </div>

                    <!-- ===== TODAY ===== -->
                    <div class="period-section visible" id="section-today">
                        <div class="period-header">
                            <h2 class="period-title">Today</h2>
                            <span class="period-sub">Today's performance</span>
                        </div>

                        <div class="summary-row">
                            <div class="summary-card revenue">
                                <div class="summary-icon"><i class="fas fa-rupee-sign"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">₹<%= todayRevenue %>
                                    </h4>
                                    <span class="summary-label">Total Revenue</span>
                                </div>
                            </div>
                            <div class="summary-card orders">
                                <div class="summary-icon"><i class="fas fa-shopping-bag"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">
                                        <%=todayTotalOrder%>
                                    </h4>
                                    <span class="summary-label">Total Orders</span>
                                </div>
                            </div>
                            <div class="summary-card profit">
                                <div class="summary-icon"><i class="fas fa-chart-line"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">₹<%=todayProfit%>
                                    </h4>
                                    <span class="summary-label">Net Profit</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- ===== LAST WEEK ===== -->
                    <div class="period-section" id="section-week">
                        <div class="period-header">
                            <h2 class="period-title">Last Week</h2>
                            <span class="period-sub">Performance over the past 7 days</span>
                        </div>

                        <div class="summary-row">
                            <div class="summary-card revenue">
                                <div class="summary-icon"><i class="fas fa-rupee-sign"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">₹<%=lastWeekRevenue%>
                                    </h4>
                                    <span class="summary-label">Total Revenue</span>
                                </div>
                            </div>
                            <div class="summary-card orders">
                                <div class="summary-icon"><i class="fas fa-shopping-bag"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">
                                        <%=totalLastWeekorders%>
                                    </h4>
                                    <span class="summary-label">Total Orders</span>
                                </div>
                            </div>
                            <div class="summary-card profit">
                                <div class="summary-icon"><i class="fas fa-chart-line"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">₹<%=lastWeekProfit%>
                                    </h4>
                                    <span class="summary-label">Net Profit</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- ===== LAST MONTH ===== -->
                    <div class="period-section" id="section-month">
                        <div class="period-header">
                            <h2 class="period-title">Last Month</h2>
                            <span class="period-sub">Performance over the past 30 days</span>
                        </div>

                        <div class="summary-row">
                            <div class="summary-card revenue">
                                <div class="summary-icon"><i class="fas fa-rupee-sign"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">₹<%=lastMonthRevenue%>
                                    </h4>
                                    <span class="summary-label">Total Revenue</span>
                                </div>
                            </div>
                            <div class="summary-card orders">
                                <div class="summary-icon"><i class="fas fa-shopping-bag"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">
                                        <%=totallastMonthOrders%>
                                    </h4>
                                    <span class="summary-label">Total Orders</span>
                                </div>
                            </div>
                            <div class="summary-card profit">
                                <div class="summary-icon"><i class="fas fa-chart-line"></i></div>
                                <div class="summary-details">
                                    <h4 class="summary-value">₹<%=lastMonthProfit%>
                                    </h4>
                                    <span class="summary-label">Net Profit</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- ===== REPORTS ===== -->
                    <div class="section-head">
                        <div>
                            <h2 class="section-title">Reports</h2>
                            <p class="section-sub">Generate and download business reports</p>
                        </div>
                        <span class="section-badge">Quick Access</span>
                    </div>

                    <div class="report-row">
                        <button type="button" class="report-card" data-report="sales">
                            <div class="report-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                            <div class="report-details">
                                <h4 class="report-title">Sales Report</h4>
                                <span class="report-desc">Revenue by date range</span>
                            </div>
                        </button>

                        <button type="button" class="report-card" data-report="customers"
                            data-href="/download-user-list">
                            <div class="report-icon"><i class="fas fa-users"></i></div>
                            <div class="report-details">
                                <h4 class="report-title">Customer List</h4>
                                <span class="report-desc">All registered customers</span>
                            </div>
                        </button>

                        <button type="button" class="report-card" data-report="stock"
                            data-href="/download-stock-balance">
                            <div class="report-icon"><i class="fas fa-boxes-stacked"></i></div>
                            <div class="report-details">
                                <h4 class="report-title">Stock Balance</h4>
                                <span class="report-desc">Current stock on hand</span>
                            </div>
                        </button>
                    </div>

                    <!-- DATE RANGE (shown when Sales Report is selected) -->
                    <div class="date-range-panel" id="dateRangePanel">
                        <form class="date-range-form" id="salesReportForm" method="GET" action="/download-sale-report">
                            <div class="date-field">
                                <label for="fromDate">From Date</label>
                                <input type="date" id="fromDate" name="start_date" required />
                            </div>
                            <div class="date-field">
                                <label for="toDate">To Date</label>
                                <input type="date" id="toDate" name="end_date" required />
                            </div>
                            <button type="submit" class="btn-generate">
                                <i class="fas fa-magnifying-glass"></i> Generate Report
                            </button>
                        </form>
                    </div>

                </div>
            </main>
        </div>

        <script>
            // ---- Period tabs ----
            const tabs = document.querySelectorAll('.filter-btn');
            const sections = {
                today: document.getElementById('section-today'),
                week: document.getElementById('section-week'),
                month: document.getElementById('section-month')
            };

            function showSection(key) {
                tabs.forEach(btn => {
                    btn.classList.toggle('active', btn.dataset.filter === key);
                });
                Object.keys(sections).forEach(k => {
                    sections[k].classList.toggle('visible', k === key);
                });
            }

            tabs.forEach(btn => {
                btn.addEventListener('click', () => showSection(btn.dataset.filter));
            });

            showSection('today');

            // ---- Report cards ----
            const reportCards = document.querySelectorAll('.report-card');
            const datePanel = document.getElementById('dateRangePanel');
            const fromDate = document.getElementById('fromDate');
            const toDate = document.getElementById('toDate');
            const salesForm = document.getElementById('salesReportForm');

            // local YYYY-MM-DD (avoids UTC day-shift)
            const fmtDate = d => {
                const y = d.getFullYear();
                const m = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${y}-${m}-${day}`;
            };

            function setDefaultDates() {
                const today = new Date();
                const firstOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);

                if (!fromDate.value) fromDate.value = fmtDate(firstOfMonth);
                if (!toDate.value) toDate.value = fmtDate(today);

                fromDate.max = fmtDate(today);
                toDate.max = fmtDate(today);
            }

            reportCards.forEach(card => {
                card.addEventListener('click', () => {
                    reportCards.forEach(c => c.classList.toggle('active', c === card));

                    if (card.dataset.report === 'sales') {
                        datePanel.classList.add('visible');
                        fromDate.focus();
                    } else {
                        datePanel.classList.remove('visible');
                        const href = card.dataset.href;
                        if (href) window.location.href = href;
                    }
                });
            });

            // keep "from" <= "to"
            fromDate.addEventListener('change', () => {
                toDate.min = fromDate.value;
                if (toDate.value && toDate.value < fromDate.value) toDate.value = fromDate.value;
            });

            salesForm.addEventListener('submit', e => {
                if (fromDate.value > toDate.value) {
                    e.preventDefault();
                    alert('"From Date" cannot be after "To Date".');
                }
            });

            setDefaultDates();
        </script>
    </body>

</html>